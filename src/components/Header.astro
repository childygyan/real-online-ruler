---
/**
 * Site header: wordmark, primary nav, language switcher, theme toggle.
 * Phase 8: all strings from the locale dictionary; nav hrefs localized.
 */
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getDict } from '../i18n/dict.js';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales.js';
import { localizePath } from '../i18n/urls.js';

interface Props {
  locale?: LocaleCode;
  path?: string;
}

const { locale = DEFAULT_LOCALE, path = '/' } = Astro.props;
const t = getDict(locale);
const h = t.header;
const homeHref = localizePath('/', locale);
---

<header
  class="sticky top-0 z-40 border-b"
  style="background-color: var(--ror-bg); border-color: var(--ror-border);"
>
  <div class="ror-container flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5" aria-label={h.wordmarkAria}>
      <!-- Wordmark: a small ruler glyph drawn inline (original artwork). -->
      <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
        <rect x="2" y="9" width="30" height="16" rx="3" fill="#0e7490" />
        <g stroke="#ffffff" stroke-width="1.6" stroke-linecap="round">
          <line x1="8" y1="9" x2="8" y2="15" />
          <line x1="13" y1="9" x2="13" y2="13" />
          <line x1="18" y1="9" x2="18" y2="15" />
          <line x1="23" y1="9" x2="23" y2="13" />
          <line x1="28" y1="9" x2="28" y2="15" />
        </g>
        <line
          x1="2"
          y1="21"
          x2="32"
          y2="21"
          stroke="#fbbf24"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
      <span class="text-lg font-bold tracking-tight">
        Real&nbsp;<span style="color: var(--ror-brand-600);">Online&nbsp;Ruler</span>
      </span>
    </a>

    <nav aria-label={h.navAria} class="hidden items-center gap-1 md:flex">
      {h.nav.map((item) => (
        <a
          href={localizePath(item.href, locale)}
          class="rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-slate-100 dark:hover:bg-slate-800"
          style="color: var(--ror-text-muted);"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} path={path} label={h.languageAria} />
      <button
        id="theme-toggle"
        type="button"
        class="ror-btn-ghost !px-3 !py-2"
        aria-label={h.themeAria}
        title={h.themeTitle}
      >
        <svg
          class="hidden dark:block"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          class="dark:hidden"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <span class="sr-only">{h.themeSr}</span>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav
    aria-label={h.navMobileAria}
    class="border-t px-4 py-2 md:hidden"
    style="border-color: var(--ror-border);"
  >
    <ul class="flex flex-wrap gap-1">
      {h.nav.map((item) => (
        <li>
          <a
            href={localizePath(item.href, locale)}
            class="block rounded-md px-3 py-2 text-sm font-medium"
            style="color: var(--ror-text-muted);"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('ror-theme', dark ? 'dark' : 'light');
      } catch {
        /* storage unavailable */
      }
    });
    // Keyboard shortcut: D toggles the theme (full shortcut map lands in Phase 4).
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'd' || ev.key === 'D') {
        var tag = (document.activeElement && document.activeElement.tagName) || '';
        if (tag === 'INPUT' || tag === 'TEXTAREA') return;
        btn.click();
      }
    });
  })();
</script>
