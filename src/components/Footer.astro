---
/** Site footer. */
const year = new Date().getFullYear();
---

<footer
  class="mt-20 border-t"
  style="border-color: var(--ror-border); background-color: var(--ror-bg-soft);"
>
  <div class="ror-container grid gap-10 py-12 md:grid-cols-4">
    <div>
      <p class="text-base font-bold">Real Online Ruler</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed" style="color: var(--ror-text-muted);">
        A free, no-signup measuring tool that turns your screen into a ruler at true physical size —
        in centimeters, millimeters, inches, and pixels.
      </p>
    </div>
    <nav aria-label="Footer">
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        Explore
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="hover:underline" href="/">
            Home
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/#calibration">
            How to calibrate
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/#guide">
            Reading guide
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/#faq">
            FAQ
          </a>
        </li>
      </ul>
    </nav>
    <nav aria-label="Ruler guides">
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        Ruler guides
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a class="hover:underline" href="/how-to-calibrate/">
            How to calibrate
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/guide/">
            Reading the ruler
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/cm/">
            Centimeter ruler
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/inches/">
            Inch ruler
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/mm/">
            Millimeter ruler
          </a>
        </li>
        <li>
          <a class="hover:underline" href="/pixels/">
            Pixel ruler
          </a>
        </li>
      </ul>
    </nav>
    <div>
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        Accuracy note
      </p>
      <p class="mt-3 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
        On-screen measurements are only as accurate as your calibration. Calibrate once for your
        display, keep browser zoom at 100%, and the ruler stays true on every visit.
      </p>
    </div>
  </div>
  <div class="border-t py-6" style="border-color: var(--ror-border);">
    <p class="ror-container text-xs" style="color: var(--ror-text-muted);">
      © {year} Real Online Ruler. Free for everyone — no account, no download.
    </p>
  </div>
</footer>
