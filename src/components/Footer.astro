---
/** Site footer. Phase 8: strings from the locale dictionary, links localized. */
import { getDict, fill } from '../i18n/dict.js';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales.js';
import { localizePath } from '../i18n/urls.js';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);
const f = t.footer;
const year = new Date().getFullYear();
---

<footer
  class="mt-20 border-t"
  style="border-color: var(--ror-border); background-color: var(--ror-bg-soft);"
>
  <div class="ror-container grid gap-10 py-12 md:grid-cols-4">
    <div>
      <p class="text-base font-bold">Real Online Ruler</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed" style="color: var(--ror-text-muted);">
        {f.tagline}
      </p>
    </div>
    <nav aria-label="Footer">
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        {f.explore}
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        {f.exploreLinks.map((l) => (
          <li>
            <a class="hover:underline" href={localizePath(l.href, locale)}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Ruler guides">
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        {f.rulerGuides}
      </p>
      <ul class="mt-3 space-y-2 text-sm">
        {f.guideLinks.map((l) => (
          <li>
            <a class="hover:underline" href={localizePath(l.href, locale)}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div>
      <p
        class="text-sm font-semibold uppercase tracking-wider"
        style="color: var(--ror-text-muted);"
      >
        {f.accuracyTitle}
      </p>
      <p class="mt-3 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
        {f.accuracyBody}
      </p>
    </div>
  </div>
  <div class="border-t py-6" style="border-color: var(--ror-border);">
    <div
      class="ror-container flex flex-col gap-3 text-xs sm:flex-row sm:items-center sm:justify-between"
      style="color: var(--ror-text-muted);"
    >
      <p>{fill(f.copyright, { year })}</p>
      <nav aria-label={f.legalLabel}>
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          {f.legalLinks.map((l) => (
            <li>
              <a class="hover:underline" href={localizePath(l.href, locale)}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>
