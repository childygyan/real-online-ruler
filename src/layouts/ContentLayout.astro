---
/**
 * ContentLayout.astro — shared shell for the Phase 5 SEO content pages.
 * Hero (h1 + lede), prose slot, related links, back-to-ruler CTA,
 * optional JSON-LD blocks.
 */
import BaseLayout from './BaseLayout.astro';
import { getDict } from '../i18n/dict.js';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales.js';
import { localizePath } from '../i18n/urls.js';

interface RelatedLink {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  lede: string;
  breadcrumb: string;
  locale?: LocaleCode;
  jsonLd?: Record<string, unknown>[];
  related?: RelatedLink[];
  /** Locales this page exists in (default: all). English-only articles pass ['en']. */
  locales?: LocaleCode[];
  /** ISO publish date (e.g. "2026-10-04") — rendered under the lede for articles. */
  datePublished?: string;
}

const {
  title,
  description,
  path,
  h1,
  lede,
  breadcrumb,
  locale = DEFAULT_LOCALE,
  jsonLd = [],
  related = [],
  locales,
  datePublished,
} = Astro.props;
const t = getDict(locale);
const l = t.layout;

const prettyDate = datePublished
  ? new Date(`${datePublished}T00:00:00Z`).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  locale={locale}
  locales={locales}
>
  {jsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
  <article class="ror-container max-w-3xl py-14 sm:py-16">
    <nav aria-label={l.breadcrumbAria} class="text-xs" style="color: var(--ror-text-muted);">
      <a href={localizePath('/', locale)} class="hover:underline">
        {l.breadcrumbHome}
      </a>
      <span aria-hidden="true" class="mx-1.5">
        /
      </span>
      <span aria-current="page">{breadcrumb}</span>
    </nav>

    <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">{h1}</h1>
    {prettyDate && (
      <p class="mt-3 text-sm" style="color: var(--ror-text-muted);">
        <time datetime={datePublished}>Published on {prettyDate}</time>
      </p>
    )}
    <p class="mt-5 text-lg leading-relaxed" style="color: var(--ror-text-muted);">
      {lede}
    </p>

    <div class="ror-prose mt-10">
      <slot />
    </div>

    {related.length > 0 && (
      <aside class="ror-card mt-12 p-6" aria-label={l.relatedAria}>
        <h2 class="!mt-0 text-lg font-bold">{l.keepReading}</h2>
        <ul class="!mt-3 space-y-2">
          {related.map((r) => (
            <li>
              <a
                href={localizePath(r.href, locale)}
                class="font-medium hover:underline"
                style="color: var(--ror-brand-700);"
              >
                {r.label}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div
      class="ror-card mt-12 flex flex-col items-center gap-4 p-8 text-center"
      style="background-color: var(--ror-brand-50);"
    >
      <p class="text-xl font-bold">{l.ctaTitle}</p>
      <p class="max-w-md text-sm" style="color: var(--ror-text-muted);">
        {l.ctaBody}
      </p>
      <a href={localizePath('/#ruler-app', locale)} class="ror-btn-primary">
        {l.ctaButton}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .ror-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .ror-prose :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .ror-prose :global(p) {
    margin-top: 0.9rem;
    line-height: 1.75;
    color: var(--ror-text-muted);
  }
  .ror-prose :global(ul),
  .ror-prose :global(ol) {
    margin-top: 0.9rem;
    padding-left: 1.5rem;
    line-height: 1.75;
    color: var(--ror-text-muted);
  }
  .ror-prose :global(ul) {
    list-style: disc;
  }
  .ror-prose :global(ol) {
    list-style: decimal;
  }
  .ror-prose :global(li) {
    margin-top: 0.4rem;
  }
  .ror-prose :global(li::marker) {
    color: var(--ror-brand-600);
  }
  .ror-prose :global(table) {
    width: 100%;
    margin-top: 1rem;
    font-size: 0.9rem;
    border-collapse: collapse;
  }
  .ror-prose :global(th),
  .ror-prose :global(td) {
    border: 1px solid var(--ror-border);
    padding: 0.55rem 0.8rem;
    text-align: left;
  }
  .ror-prose :global(th) {
    background-color: var(--ror-bg-soft);
    font-weight: 700;
    color: var(--ror-text);
  }
  .ror-prose :global(td) {
    color: var(--ror-text-muted);
  }
  .ror-prose :global(a) {
    color: var(--ror-brand-700);
    font-weight: 600;
  }
  .ror-prose :global(a:hover) {
    text-decoration: underline;
  }
  .ror-prose :global(strong) {
    color: var(--ror-text);
  }
  .ror-prose :global(code) {
    font-size: 0.85em;
    background-color: var(--ror-bg-soft);
    border: 1px solid var(--ror-border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .ror-prose :global(figure.ror-figure) {
    margin-top: 1.75rem;
    border: 1px solid var(--ror-border);
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--ror-bg-soft);
  }
  .ror-prose :global(figure.ror-figure img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ror-prose :global(figure.ror-figure figcaption) {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ror-text-muted);
  }
</style>
