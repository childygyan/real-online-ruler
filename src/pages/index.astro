---
/**
 * Home page. Phase 8: fully locale-driven via the home dictionary;
 * mirrored under /{locale}/ via thin wrapper pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CalibrateModal from '../components/CalibrateModal.astro';
import RulerApp from '../components/RulerApp.astro';
import { getDict } from '../i18n/dict.js';
import { DEFAULT_LOCALE, type LocaleCode } from '../i18n/locales.js';
import { localizePath } from '../i18n/urls.js';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale).home;

const siteUrl = 'https://realonlineruler.online';
const pageUrl = siteUrl + localizePath('/', locale);

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Real Online Ruler',
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern web browser with JavaScript enabled.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: t.jsonLdDescription,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={t.title} description={t.description} path="/" locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <!-- Hero -->
  <section class="ror-container pb-14 pt-14 text-center sm:pt-20">
    <p
      class="mx-auto inline-flex items-center gap-2 rounded-full border px-4 py-1.5 text-xs font-semibold uppercase tracking-widest"
      style="border-color: var(--ror-brand-200); color: var(--ror-brand-700); background-color: var(--ror-brand-50);"
    >
      <span aria-hidden="true">●</span> {t.badge}
    </p>
    <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
      {t.h1Before}
      <span style="color: var(--ror-brand-600);">{t.h1Emphasis}</span>
      {t.h1After}
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed" style="color: var(--ror-text-muted);">
      {t.lede}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={localizePath('/#ruler-app', locale)} class="ror-btn-primary">
        {t.openRuler}
      </a>
      <a href={localizePath('/#calibration', locale)} class="ror-btn-ghost">
        {t.howCalibration}
      </a>
    </div>
    <p class="mt-6 text-sm" style="color: var(--ror-text-muted);">
      {t.tip}
    </p>
  </section>

  <!-- App shell: the live ruler. -->
  <section id="ruler-app" class="ror-container scroll-mt-20" aria-label={t.workspaceAria}>
    <RulerApp locale={locale} />
  </section>

  <CalibrateModal locale={locale} />

  <!-- Features -->
  <section class="ror-container mt-20" aria-label={t.featuresAria}>
    <h2 class="text-center text-3xl font-bold tracking-tight">{t.featuresTitle}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center" style="color: var(--ror-text-muted);">
      {t.featuresLede}
    </p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.features.map((f) => (
        <article class="ror-card p-6">
          <div
            class="flex h-11 w-11 items-center justify-center rounded-lg text-xl"
            style="background-color: var(--ror-brand-50); color: var(--ror-brand-700);"
            aria-hidden="true"
          >
            {f.icon}
          </div>
          <h3 class="mt-4 text-lg font-semibold">{f.name}</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
            {f.body}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Calibration explainer -->
  <section id="calibration" class="ror-container mt-20 scroll-mt-20" aria-label={t.calibrationAria}>
    <div class="ror-card p-8 sm:p-10">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.calibrationTitle}</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <div class="space-y-4 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
          {t.calibrationParas.map((para) => (
            <p set:html={para} />
          ))}
        </div>
        <ol class="space-y-4">
          {t.methods.map((m, i) => (
            <li class="flex gap-4">
              <span
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
                style="background-color: var(--ror-brand-700);"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div>
                <p class="font-semibold">{m.name}</p>
                <p class="mt-1 text-sm" style="color: var(--ror-text-muted);">
                  {m.body}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <p
        class="mt-6 rounded-lg border px-4 py-3 text-sm"
        style="border-color: var(--ror-brand-200); background-color: var(--ror-brand-50); color: var(--ror-brand-900);"
      >
        {t.liveNote}
      </p>
    </div>
  </section>

  <!-- Reading guide -->
  <section id="guide" class="ror-container mt-20 scroll-mt-20" aria-label={t.guideAria}>
    <h2 class="text-center text-3xl font-bold tracking-tight">{t.guideTitle}</h2>
    <div class="mx-auto mt-8 grid max-w-4xl gap-5 md:grid-cols-3">
      {t.units.map((u) => (
        <article class="ror-card p-6">
          <h3 class="text-lg font-semibold" style="color: var(--ror-brand-700);">
            {u.name}
          </h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
            {u.body}
          </p>
        </article>
      ))}
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-center text-sm" style="color: var(--ror-text-muted);">
      {t.guideLinksIntro}{' '}
      {t.guideLinks.map((l, i) => (
        <>
          <a
            href={localizePath(l.href, locale)}
            class="font-medium hover:underline"
            style="color: var(--ror-brand-700);"
          >
            {l.label}
          </a>
          {i < t.guideLinks.length - 1 ? ' · ' : ''}
        </>
      ))}
      {/* English-only how-to section link (no localized version yet) */}
      {locale === 'en' && (
        <>
          {' · '}
          <a
            href="/how-to/"
            class="font-medium hover:underline"
            style="color: var(--ror-brand-700);"
          >
            How-to guides
          </a>
        </>
      )}
    </p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="ror-container mt-20 scroll-mt-20" aria-label={t.faqAria}>
    <h2 class="text-center text-3xl font-bold tracking-tight">{t.faqTitle}</h2>
    <div class="mx-auto mt-8 max-w-3xl space-y-4">
      {t.faqs.map((f) => (
        <details class="ror-card group px-6 py-4">
          <summary class="cursor-pointer list-none font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {f.q}
              <span
                class="text-xl transition-transform group-open:rotate-45"
                style="color: var(--ror-brand-600);"
                aria-hidden="true"
              >
                +
              </span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed" style="color: var(--ror-text-muted);">
            {f.a}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
