---
/**
 * /pixels/ — pixel ruler page. Phase 8: locale-driven via the
 * content.pixels dictionary; mirrored under /{locale}/pixels/.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import ContentBlocks from '../../components/ContentBlocks.astro';
import { getDict } from '../../i18n/dict.js';
import { DEFAULT_LOCALE, type LocaleCode } from '../../i18n/locales.js';

interface Props {
  locale?: LocaleCode;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale).content.pixels;
const path = '/pixels/';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<ContentLayout
  title={t.title}
  description={t.description}
  path={path}
  h1={t.h1}
  lede={t.lede}
  breadcrumb={t.breadcrumb}
  locale={locale}
  jsonLd={[faqJsonLd]}
  related={t.related}
>
  <ContentBlocks blocks={t.blocks} locale={locale} />
</ContentLayout>
